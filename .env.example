# Copy this file to .env and fill in real values for your environment.
# .env is git-ignored — never commit it.

# "local" writes to LOCAL_DATA_ROOT on disk (zero cloud setup, used for dev).
# "r2" writes to the Cloudflare R2 bucket below (used in CI / production).
STORAGE_BACKEND=local

# Root directory for the local lakehouse when STORAGE_BACKEND=local.
LOCAL_DATA_ROOT=./data

# Cloudflare R2 credentials — only required when STORAGE_BACKEND=r2.
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET=

# Days to retain bronze/silver partitions before the retention job deletes them.
# Gold is retained forever regardless of this value.
BRONZE_RETENTION_DAYS=7

# Comma-separated GH Archive event types to keep during ingest; everything
# else is dropped at the bronze layer to control storage volume.
EVENT_TYPES=PushEvent,PullRequestEvent,IssuesEvent,IssueCommentEvent,WatchEvent,ForkEvent

# Maximum acceptable age (hours) of the freshest gold data before the
# freshness check reports the pipeline as stale.
FRESHNESS_SLA_HOURS=3

# Destination address for failure alert emails. Leave blank to disable alerting.
ALERT_EMAIL=
